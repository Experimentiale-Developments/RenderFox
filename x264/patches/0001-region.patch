+         * region's needs none, as every vector found is clipped to it (me.c). */
+        int fpel_lo = X264_MAX( (h->mb.mv_min_spel[i]>>2) + i_fpel_border, lo == INT_MIN ? INT_MIN : (lo + 3) >> 2 );
+        int fpel_hi = X264_MIN( (h->mb.mv_max_spel[i]>>2) - i_fpel_border, hi == INT_MAX ? INT_MAX : hi >> 2 );
+        h->mb.mv_min_spel[i] = X264_MAX( h->mb.mv_min_spel[i], lo );
+        h->mb.mv_max_spel[i] = X264_MIN( h->mb.mv_max_spel[i], hi );
