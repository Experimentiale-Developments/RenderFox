+    h->mb.mv_min_spel[1] = h->mb.region_spel_y[0];
+    h->mb.mv_max_spel[1] = h->mb.region_spel_y[1];
+    for( int i = 0; i < 2; i++ )
+    {
+        int lo = h->mb.region_mv[i][!h->mb.region_lock[i]][0], hi = h->mb.region_mv[i][!h->mb.region_lock[i]][1];
