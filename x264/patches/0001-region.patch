+ * is fractional the 6-tap luma filter reaches 2 further before and 3 after; chroma's
+ * bilinear filter never reaches as far, and a whole-pixel component needs no filter on
+ * its axis. Next to the edge, where the fractional bounds would shut out the zero vector,
+ * the search keeps that axis to whole pixels, which may come right up to the edge: static
+ * content there can still be skipped, and the other axis stays as precise as ever. */
+static void mb_analyse_region( x264_t *h, x264_mb_analysis_t *a, int i_fpel_border )
+{
+    int x0 = h->param.region.i_x0, y0 = h->param.region.i_y0;
+    int x1 = h->param.region.i_x1, y1 = h->param.region.i_y1;
+    int mb_x = h->mb.i_mb_x, mb_y = h->mb.i_mb_y;
+    int p[2] = { 16*mb_x, 16*mb_y };
+    /* The pixels this macroblock may read, per axis; an open end is unbounded. */
+    int first[2] = { INT_MIN, INT_MIN }, last[2] = { INT_MAX, INT_MAX };
+    if( mb_x >= x0 && mb_x < x1 && mb_y >= y0 && mb_y < y1 )
+    {
+        /* Inside stays inside. A side on the frame's edge is open: the padding past it
+         * repeats the region's own pixels. */
+        if( x0 > 0 )
+            first[0] = 16*x0;
+        if( x1 < h->mb.i_mb_width )
+            last[0] = 16*x1 - 1;
+        if( y0 > 0 )
+            first[1] = 16*y0;
+        if( y1 < h->mb.i_mb_height )
+            last[1] = 16*y1 - 1;
+    }
+    else
+    {
+        /* Outside keeps off the region on whichever side leaves it most room, ties going
+         * to the vertical (the stream's camera pans). */
+        int room = -1, side = 0;
+        if( mb_x >= x1 && 16*(mb_x - x1) > room )
+            room = 16*(mb_x - x1), side = 0;
+        if( mb_x < x0 && 16*(x0 - 1 - mb_x) > room )
+            room = 16*(x0 - 1 - mb_x), side = 1;
+        if( mb_y < y0 && 16*(y0 - 1 - mb_y) >= room )
+            room = 16*(y0 - 1 - mb_y), side = 2;
+        if( mb_y >= y1 && 16*(mb_y - y1) >= room )
+            room = 16*(mb_y - y1), side = 3;
+        if( side == 0 )
+            first[0] = 16*x1;
+        else if( side == 1 )
+            last[0] = 16*x0 - 1;
+        else if( side == 2 )
+            last[1] = 16*y0 - 1;
+        else
+            first[1] = 16*y1;
+    }
+
+    for( int i = 0; i < 2; i++ )
+    {
+        int (*b)[2] = h->mb.region_mv[i];
+        b[0][0] = first[i] == INT_MIN ? INT_MIN : 4*(first[i] - p[i]);
+        b[0][1] = last[i] == INT_MAX ? INT_MAX : 4*(last[i] - p[i] - 15);
+        b[1][0] = first[i] == INT_MIN ? INT_MIN : 4*(first[i] - p[i] + 2);
+        b[1][1] = last[i] == INT_MAX ? INT_MAX : 4*(last[i] - p[i] - 18) + 3;
+        h->mb.region_lock[i] = b[1][0] > 0 || b[1][1] < 0;
+    }
+    if( h->mb.region_lock[0] || h->mb.region_lock[1] )
