+/* Writing a macroblock as it was coded before (x264_copy_mb_t): its prediction is formed
+ * here as a decoder forms it, from this encoder's reconstruction, and its levels are
+ * added back the way a decoder adds them, so what this encoder holds is what a decoder
+ * of its slices holds. */
+
+/* A DC prediction mode adjusted to the neighbours there are, as analysis picks it. */
+static int copy_dc_mode( int mode, int dc, unsigned nb, int dc_left, int dc_top, int dc_128 )
+{
+    if( mode != dc )
+        return mode;
+    if( (nb & (MB_LEFT|MB_TOP)) == (MB_LEFT|MB_TOP) )
+        return dc;
+    if( nb & MB_LEFT )
+        return dc_left;
+    if( nb & MB_TOP )
+        return dc_top;
+    return dc_128;
+}
+
+static void copy_unscan4( dctcoef dct[16], const int16_t level[16], int from )
+{
+    memset( dct, 0, 16 * sizeof(dctcoef) );
+    for( int i = from; i < 16; i++ )
+        dct[x264_zigzag_scan4[0][i]] = level[i];
+}
+
+static int copy_nz( const int16_t *level, int n )
+{
+    for( int i = 0; i < n; i++ )
+        if( level[i] )
+            return 1;
+    return 0;
+}
+
+/* The residual of one luma 4x4 block (inter or I4x4) onto its prediction. */
+static void copy_add4x4( x264_t *h, const x264_copy_mb_t *c, int i, int cat, int qp )
+{
+    ALIGNED_ARRAY_64( dctcoef, dct,[16] );
+    const int16_t *level = &c->luma[16*i];
+    int nz = (c->i_cbp_luma >> (i>>2)) & 1 && copy_nz( level, 16 );
+    h->mb.cache.non_zero_count[x264_scan8[i]] = nz;
+    if( !nz )
+    {
+        memset( h->dct.luma4x4[i], 0, 16 * sizeof(dctcoef) );
+        return;
+    }
+    for( int k = 0; k < 16; k++ )
+        h->dct.luma4x4[i][k] = level[k];
+    copy_unscan4( dct, level, 0 );
+    h->quantf.dequant_4x4( dct, h->dequant4_mf[cat], qp );
+    h->dctf.add4x4_idct( &h->mb.pic.p_fdec[0][block_idx_xy_fdec[i]], dct );
+}
+
+static void copy_add8x8( x264_t *h, const x264_copy_mb_t *c, int i, int cat, int qp )
+{
+    ALIGNED_ARRAY_64( dctcoef, dct,[64] );
+    const int16_t *level = &c->luma[64*i];
+    int nz = (c->i_cbp_luma >> i) & 1 && copy_nz( level, 64 );
+    STORE_8x8_NNZ( 0, i, nz );
+    if( !nz )
+    {
+        memset( h->dct.luma8x8[i], 0, 64 * sizeof(dctcoef) );
+        return;
+    }
+    memset( dct, 0, sizeof(dct) );
+    for( int k = 0; k < 64; k++ )
+    {
+        h->dct.luma8x8[i][k] = level[k];
+        dct[x264_zigzag_scan8[0][k]] = level[k];
+    }
+    h->quantf.dequant_8x8( dct, h->dequant8_mf[cat], qp );
+    h->dctf.add8x8_idct8( &h->mb.pic.p_fdec[0][8*(i&1) + 8*(i>>1)*FDEC_STRIDE], dct );
+}
+
+static void copy_chroma( x264_t *h, const x264_copy_mb_t *c, int b_inter )
+{
+    int qp = h->mb.i_chroma_qp;
+    int (*dequant_mf)[16] = h->dequant4_mf[CQM_4IC + b_inter];
+    for( int ch = 0; ch < 2; ch++ )
+    {
+        ALIGNED_ARRAY_64( dctcoef, dct4x4,[4],[16] );
+        ALIGNED_ARRAY_16( dctcoef, dct_dc,[4] );
+        int nz_dc = c->i_cbp_chroma && copy_nz( c->chroma_dc[ch], 4 );
+        h->mb.cache.non_zero_count[x264_scan8[CHROMA_DC+ch]] = nz_dc;
+        for( int k = 0; k < 4; k++ )
+            h->dct.chroma_dc[ch][k] = nz_dc ? c->chroma_dc[ch][k] : 0;
+        int nz_ac = 0;
+        for( int i = 0; i < 4; i++ )
+        {
+            int idx = 16 + 16*ch + i;
+            const int16_t *level = c->chroma_ac[4*ch + i];
+            int nz = c->i_cbp_chroma == 2 && copy_nz( level + 1, 15 );
+            h->mb.cache.non_zero_count[x264_scan8[idx]] = nz;
+            nz_ac |= nz;
+            for( int k = 0; k < 16; k++ )
+                h->dct.luma4x4[idx][k] = nz && k ? level[k] : 0;
+            copy_unscan4( dct4x4[i], level, 1 );
+            if( nz )
+                h->quantf.dequant_4x4( dct4x4[i], dequant_mf, qp );
+            else
+                memset( dct4x4[i], 0, sizeof(dct4x4[i]) );
+        }
+        if( !nz_dc && !nz_ac )
+            continue;
+        if( nz_dc )
+        {
+            /* The 2x2 DC scan is x264's dct[x*2+y]. */
+            dct_dc[0] = c->chroma_dc[ch][0];
+            dct_dc[2] = c->chroma_dc[ch][1];
+            dct_dc[1] = c->chroma_dc[ch][2];
+            dct_dc[3] = c->chroma_dc[ch][3];
+            idct_dequant_2x2_dc( dct_dc, dct4x4, dequant_mf, qp );
+        }
+        h->dctf.add8x8_idct( h->mb.pic.p_fdec[1+ch], dct4x4 );
+    }
+}
+
+static void copy_intra_luma( x264_t *h, const x264_copy_mb_t *c )
+{
+    int qp = h->mb.i_qp;
+    if( h->mb.i_type == I_4x4 )
+    {
+        for( int i = 0; i < 16; i++ )
+        {
+            pixel *p_dst = &h->mb.pic.p_fdec[0][block_idx_xy_fdec[i]];
+            int mode = h->mb.cache.intra4x4_pred_mode[x264_scan8[i]];
+            if( (h->mb.i_neighbour4[i] & (MB_TOPRIGHT|MB_TOP)) == MB_TOP )
+                /* emulate missing topright samples */
+                MPIXEL_X4( &p_dst[4-FDEC_STRIDE] ) = PIXEL_SPLAT_X4( p_dst[3-FDEC_STRIDE] );
+            h->predict_4x4[mode]( p_dst );
+            copy_add4x4( h, c, i, CQM_4IY, qp );
+        }
+    }
+    else if( h->mb.i_type == I_8x8 )
+    {
+        ALIGNED_ARRAY_32( pixel, edge,[36] );
+        for( int i = 0; i < 4; i++ )
+        {
+            pixel *p_dst = &h->mb.pic.p_fdec[0][8*(i&1) + 8*(i>>1)*FDEC_STRIDE];
+            int mode = h->mb.cache.intra4x4_pred_mode[x264_scan8[4*i]];
+            h->predict_8x8_filter( p_dst, edge, h->mb.i_neighbour8[i], x264_pred_i4x4_neighbors[mode] );
+            h->predict_8x8[mode]( p_dst, edge );
+            copy_add8x8( h, c, i, CQM_8IY, qp );
+        }
+    }
+    else
+    {
+        ALIGNED_ARRAY_64( dctcoef, dct4x4,[16],[16] );
+        ALIGNED_ARRAY_64( dctcoef, dct_dc4x4,[16] );
+        pixel *p_dst = h->mb.pic.p_fdec[0];
+        h->predict_16x16[h->mb.i_intra16x16_pred_mode]( p_dst );
+        int any = 0;
+        for( int i = 0; i < 16; i++ )
+        {
+            const int16_t *level = &c->luma[16*i];
+            int nz = c->i_cbp_luma && copy_nz( level + 1, 15 );
+            h->mb.cache.non_zero_count[x264_scan8[i]] = nz;
+            for( int k = 0; k < 16; k++ )
+                h->dct.luma4x4[i][k] = nz && k ? level[k] : 0;
+            copy_unscan4( dct4x4[i], level, 1 );
+            if( nz )
+                h->quantf.dequant_4x4( dct4x4[i], h->dequant4_mf[CQM_4IY], qp );
+            else
+                memset( dct4x4[i], 0, sizeof(dct4x4[i]) );
+            any |= nz;
+        }
+        int nz_dc = copy_nz( c->luma_dc, 16 );
+        h->mb.cache.non_zero_count[x264_scan8[LUMA_DC]] = nz_dc;
+        for( int k = 0; k < 16; k++ )
+            h->dct.luma16x16_dc[0][k] = c->luma_dc[k];
+        if( nz_dc )
+        {
+            copy_unscan4( dct_dc4x4, c->luma_dc, 0 );
+            h->dctf.idct4x4dc( dct_dc4x4 );
+            h->quantf.dequant_4x4_dc( dct_dc4x4, h->dequant4_mf[CQM_4IY], qp );
+            for( int i = 0; i < 16; i++ )
+                dct4x4[i][0] = dct_dc4x4[block_idx_xy_1d[i]];
+            any = 1;
+        }
+        if( any )
+            h->dctf.add16x16_idct( p_dst, dct4x4 );
+    }
+}
+
+int x264_macroblock_copy( x264_t *h, const x264_copy_mb_t *c )
+{
+    int type = c->i_type;
+    int slice = h->sh.i_type;
+    int qp = c->i_qp;
+    if( qp > QP_MAX_SPEC || c->i_cbp_luma > 15 || c->i_cbp_chroma > 2 )
+        return 0;
+    int b_intra = type <= X264_COPY_I16x16;
+    if( !b_intra && (slice == SLICE_TYPE_I || h->mb.pic.i_fref[0] < 1
+                     || ((type == X264_COPY_P16x16 || type == X264_COPY_P_SKIP) != (slice == SLICE_TYPE_P))) )
+        return 0;
+    /* Recorded vectors, per 8x8 block: the same in all four where the type needs one. */
+    int lists = 0;
+    if( !b_intra )
+    {
+        for( int l = 0; l < 2; l++ )
+            if( c->ref[l][0] == 0 )
+                lists |= 1 << l;
+        for( int i = 0; i < 4; i++ )
+            for( int l = 0; l < 2; l++ )
+                if( c->ref[l][i] != c->ref[l][0] || (c->ref[l][0] == 0 && M32( c->mv[l][i] ) != M32( c->mv[l][0] )) )
+                    lists = -1;
+        if( lists == 0 && type != X264_COPY_B_DIRECT && type != X264_COPY_B_SKIP )
+            return 0;
+        for( int l = 0; l < 2; l++ )
+            for( int i = 0; i < 4; i++ )
+                if( c->ref[l][i] != 0 && c->ref[l][i] != -1 )
+                    return 0;
+    }
+
+    int mb_type, partition = D_16x16;
+    if( type == X264_COPY_P_SKIP || type == X264_COPY_P16x16 )
+    {
+        if( lists != 1 )
+            return 0;
+        mb_type = P_L0;
+        if( type == X264_COPY_P_SKIP )
+        {
+            ALIGNED_4( int16_t mvp[2] );
+            x264_mb_predict_mv_pskip( h, mvp );
+            if( M32( mvp ) == M32( c->mv[0][0] ) && c->i_cbp_luma == 0 && c->i_cbp_chroma == 0 )
+                mb_type = P_SKIP;
+            else if( c->i_cbp_luma || c->i_cbp_chroma )
+                return 0;
+        }
+    }
+    else if( type == X264_COPY_B_DIRECT || type == X264_COPY_B_SKIP )
+    {
+        h->mb.b_copying = 1;
+        int same = x264_mb_predict_mv_direct16x16( h, NULL );
+        h->mb.b_copying = 0;
+        for( int i = 0; i < 4 && same; i++ )
+            for( int l = 0; l < 2; l++ )
+                if( h->mb.cache.direct_ref[l][i] != c->ref[l][i]
+                    || (c->ref[l][i] == 0 && M32( h->mb.cache.direct_mv[l][i] ) != M32( c->mv[l][i] )) )
+                    same = 0;
+        if( same )
+        {
+            mb_type = type == X264_COPY_B_SKIP ? B_SKIP : B_DIRECT;
+            partition = h->mb.cache.direct_partition;
+        }
+        else if( lists > 0 )
+            /* What it was derived to before, written out: one vector for the lot. */
+            mb_type = lists == 1 ? B_L0_L0 : lists == 2 ? B_L1_L1 : B_BI_BI;
+        else
+            return 0;
+        if( mb_type == B_SKIP && (c->i_cbp_luma || c->i_cbp_chroma) )
+            return 0;
+    }
+    else if( type == X264_COPY_B16x16 )
+    {
+        if( lists <= 0 || slice != SLICE_TYPE_B )
+            return 0;
+        mb_type = lists == 1 ? B_L0_L0 : lists == 2 ? B_L1_L1 : B_BI_BI;
+    }
+    else if( type == X264_COPY_I4x4 )
+        mb_type = c->b_transform_8x8 ? -1 : I_4x4;
+    else if( type == X264_COPY_I8x8 )
+        mb_type = c->b_transform_8x8 && h->pps->b_transform_8x8_mode ? I_8x8 : -1;
+    else if( type == X264_COPY_I16x16 )
+        mb_type = I_16x16;
+    else
