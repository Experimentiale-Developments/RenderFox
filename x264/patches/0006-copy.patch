+        int lo[2] = { 4*( -16*h->mb.i_mb_x - 24 ), 4*( -16*h->mb.i_mb_y - 24 ) };
+        int hi[2] = { 4*( 16*( h->mb.i_mb_width - h->mb.i_mb_x - 1 ) + 24 ), 4*( 16*( h->mb.i_mb_height - h->mb.i_mb_y - 1 ) + 24 ) };
+        for( int l = 0; l < 2; l++ )
+            for( int i = 0; i < 4; i++ )
+            {
+                int ref = mb_type == B_SKIP || mb_type == B_DIRECT ? h->mb.cache.direct_ref[l][i] : c->ref[l][i];
+                const int16_t *mv = mb_type == B_SKIP || mb_type == B_DIRECT ? h->mb.cache.direct_mv[l][i]
+                                  : mb_type == P_SKIP ? c->mv[0][0] : c->mv[l][i];
+                if( ref >= 0 && (mv[0] < lo[0] || mv[0] > hi[0] || mv[1] < lo[1] || mv[1] > hi[1]) )
+                    return 0;
+            }
+        h->mb.mv_min[0] = lo[0];
+        h->mb.mv_max[0] = hi[0];
+        h->mb.mv_min[1] = lo[1];
+        h->mb.mv_max[1] = hi[1];
+    }
+    if( c->b_transform_8x8 && !b_intra && (!h->pps->b_transform_8x8_mode || !c->i_cbp_luma
+        || (mb_type == B_DIRECT && !h->sps->b_direct8x8_inference)) )
+        return 0;
+
+    /* From here on the macroblock is written as given. */
+    h->mb.i_type = mb_type;
+    h->mb.i_partition = partition;
+    h->mb.i_qp = qp;
+    h->mb.i_chroma_qp = h->chroma_qp_table[qp];
+    h->mb.b_transform_8x8 = c->b_transform_8x8 && (mb_type == I_8x8 || (!b_intra && c->i_cbp_luma));
+    h->mb.i_cbp_luma = c->i_cbp_luma;
+    h->mb.i_cbp_chroma = c->i_cbp_chroma;
+    h->mb.i_skip_intra = 0;
+    h->mb.b_skip_mc = 1;
+    for( int i = 0; i < 4; i++ )
+        h->mb.i_sub_partition[i] = D_L0_8x8;
+    M32( &h->mb.cache.non_zero_count[x264_scan8[0]+0*8] ) = 0;
+    M32( &h->mb.cache.non_zero_count[x264_scan8[0]+1*8] ) = 0;
+    M32( &h->mb.cache.non_zero_count[x264_scan8[0]+2*8] ) = 0;
+    M32( &h->mb.cache.non_zero_count[x264_scan8[0]+3*8] ) = 0;
+    h->mb.cache.non_zero_count[x264_scan8[LUMA_DC]] = 0;
+
+    if( b_intra )
+    {
+        if( mb_type == I_4x4 )
+            for( int i = 0; i < 16; i++ )
+                h->mb.cache.intra4x4_pred_mode[x264_scan8[i]] =
+                    copy_dc_mode( c->intra4x4_mode[i], I_PRED_4x4_DC, h->mb.i_neighbour4[i], I_PRED_4x4_DC_LEFT, I_PRED_4x4_DC_TOP, I_PRED_4x4_DC_128 );
+        else if( mb_type == I_8x8 )
+            for( int i = 0; i < 4; i++ )
+                x264_macroblock_cache_intra8x8_pred( h, 2*(i&1), 2*(i>>1),
+                    copy_dc_mode( c->intra4x4_mode[4*i], I_PRED_8x8_DC, h->mb.i_neighbour8[i], I_PRED_8x8_DC_LEFT, I_PRED_8x8_DC_TOP, I_PRED_8x8_DC_128 ) );
+        else
+            h->mb.i_intra16x16_pred_mode = copy_dc_mode( c->i_intra16x16_mode, I_PRED_16x16_DC, h->mb.i_neighbour_intra,
+                                                         I_PRED_16x16_DC_LEFT, I_PRED_16x16_DC_TOP, I_PRED_16x16_DC_128 );
+        h->mb.i_chroma_pred_mode = copy_dc_mode( c->i_chroma_mode, I_PRED_CHROMA_DC, h->mb.i_neighbour_intra,
+                                                 I_PRED_CHROMA_DC_LEFT, I_PRED_CHROMA_DC_TOP, I_PRED_CHROMA_DC_128 );
+        copy_intra_luma( h, c );
+        h->predict_chroma[h->mb.i_chroma_pred_mode]( h->mb.pic.p_fdec[1] );
+        h->predict_chroma[h->mb.i_chroma_pred_mode]( h->mb.pic.p_fdec[2] );
+        copy_chroma( h, c, 0 );
+    }
+    else
+    {
+        if( mb_type == B_SKIP || mb_type == B_DIRECT )
+        {
+            for( int i = 0; i < 4; i++ )
+            {
+                int x = 2*(i&1), y = i&2;
+                x264_macroblock_cache_ref( h, x, y, 2, 2, 0, h->mb.cache.direct_ref[0][i] );
+                x264_macroblock_cache_ref( h, x, y, 2, 2, 1, h->mb.cache.direct_ref[1][i] );
+                x264_macroblock_cache_mv_ptr( h, x, y, 2, 2, 0, h->mb.cache.direct_mv[0][i] );
+                x264_macroblock_cache_mv_ptr( h, x, y, 2, 2, 1, h->mb.cache.direct_mv[1][i] );
+                h->mb.i_sub_partition[i] = D_DIRECT_8x8;
+            }
+        }
+        else
+        {
+            for( int l = 0; l <= (slice == SLICE_TYPE_B); l++ )
+            {
+                if( (lists >> l) & 1 )
+                {
+                    x264_macroblock_cache_ref( h, 0, 0, 4, 4, l, 0 );
+                    x264_macroblock_cache_mv_ptr( h, 0, 0, 4, 4, l, c->mv[l][0] );
+                }
+                else
+                {
+                    x264_macroblock_cache_ref( h, 0, 0, 4, 4, l, -1 );
+                    x264_macroblock_cache_mv( h, 0, 0, 4, 4, l, 0 );
+                    x264_macroblock_cache_mvd( h, 0, 0, 4, 4, l, 0 );
+                }
+            }
+        }
+        x264_mb_mc( h );
+        if( h->mb.b_transform_8x8 )
+            for( int i = 0; i < 4; i++ )
+                copy_add8x8( h, c, i, CQM_8PY, qp );
+        else
+            for( int i = 0; i < 16; i++ )
+                copy_add4x4( h, c, i, CQM_4PY, qp );
+        copy_chroma( h, c, 1 );
+    }
+
+    int cbp = h->mb.i_cbp_chroma << 4 | h->mb.i_cbp_luma;
+    if( h->param.b_cabac )
+        cbp |= h->mb.cache.non_zero_count[x264_scan8[LUMA_DC    ]] << 8
+            |  h->mb.cache.non_zero_count[x264_scan8[CHROMA_DC+0]] << 9
+            |  h->mb.cache.non_zero_count[x264_scan8[CHROMA_DC+1]] << 10;
+    h->mb.cbp[h->mb.i_mb_xy] = cbp;
+    return 1;
+}
