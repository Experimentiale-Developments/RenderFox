[Unit]
Description=Render Fox primary uplink to the ingest
After=renderfox-relay.service
Wants=renderfox-relay.service
ConditionPathExists=@RF_HOME@/relay/uplink.env
StartLimitIntervalSec=0

[Service]
User=@RF_USER@
ExecStart=@RF_HOME@/relay/uplink.sh primary
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
